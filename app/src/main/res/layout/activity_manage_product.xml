<?xml version="1.0" encoding="utf-8"?>
<!-- Manage Product screen: Add, update, delete, search products -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Input: Product ID (used for update/delete/search) -->
    <EditText
        android:id="@+id/edit_prodid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Id"
        android:layout_margin="10dp"
        android:inputType="number" />

    <!-- Input: Product Name -->
    <EditText
        android:id="@+id/edit_prodname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Product Name"
        android:layout_margin="5dp"
        android:inputType="text" />

    <!-- Action Buttons Row 1: Save & View -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Save product -->
        <Button
            android:id="@+id/button_insert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="18sp"
            android:backgroundTint="@color/purple"
            android:textColor="@android:color/white"
            android:layout_weight="1"
            android:layout_marginTop="20dp" />

        <!-- View all products -->
        <Button
            android:id="@+id/button_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View"
            android:textSize="18sp"
            android:backgroundTint="@color/purple"
            android:textColor="@android:color/white"
            android:layout_weight="1"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- Action Buttons Row 2: Delete & Update -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Delete product by ID -->
        <Button
            android:id="@+id/button_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="18sp"
            android:backgroundTint="@color/purple"
            android:textColor="@android:color/white"
            android:layout_weight="1"
            android:layout_marginTop="20dp" />

        <!-- Update product name -->
        <Button
            android:id="@+id/button_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textSize="18sp"
            android:backgroundTint="@color/purple"
            android:textColor="@android:color/white"
            android:layout_weight="1"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- Search product by ID -->
    <Button
        android:id="@+id/button_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search"
        android:textSize="18sp"
        android:backgroundTint="@color/purple"
        android:textColor="@android:color/white"
        android:layout_marginTop="20dp" />
</LinearLayout>
