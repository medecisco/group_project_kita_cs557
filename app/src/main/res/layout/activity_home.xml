<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: Navigation hub after login -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <!-- Welcome text display -->
    <TextView
        android:id="@+id/text_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:textColor="#000000" />

    <!-- Button: Navigate to ManageUserActivity -->
    <Button
        android:id="@+id/button_manage_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage User"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/purple"
        android:textColor="@android:color/white"
        android:padding="12dp" />

    <!-- Button: Navigate to ManageProductActivity -->
    <Button
        android:id="@+id/button_manage_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Product"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/purple"
        android:textColor="@android:color/white"
        android:padding="12dp" />

    <!-- Button: Log out and return to LoginActivity -->
    <Button
        android:id="@+id/button_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textSize="18sp"
        android:backgroundTint="@color/purple"
        android:textColor="@android:color/white"
        android:padding="12dp" />

</LinearLayout>
